# ============================================================================
# UATMMS Environment Configuration Template
# 
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git (use .gitignore)
# ============================================================================

# ============================================================================
# FIREBASE AUTHENTICATION
# ============================================================================
# Get from: Firebase Console → Project Settings → Service Accounts → Generate Key
# Full JSON content or path to file
FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"}'
# Or use file path instead:
# FIREBASE_CREDENTIALS_FILE="/path/to/serviceAccountKey.json"
FIREBASE_PROJECT_ID="uatmms-project-id"

# ============================================================================
# POSTGRESQL DATABASE
# ============================================================================
# Full connection string:
DATABASE_URL="postgresql://uatmms_user:uatmms_pass@localhost:5432/uatmms_db"

# Or individual components:
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="uatmms_user"
DB_PASSWORD="uatmms_pass"
DB_NAME="uatmms_db"

# Connection pool settings:
DB_POOL_SIZE="20"
DB_POOL_RECYCLE="3600"
DB_ECHO="false"

# ============================================================================
# REDIS CACHE & SESSION STORE
# ============================================================================
# Connection string:
REDIS_URL="redis://localhost:6379/0"

# Or individual components:
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""

# ============================================================================
# AWS S3 (MODEL STORAGE & ARTIFACTS)
# ============================================================================
# Get from: AWS Console → IAM → Create User → Generate Access Keys
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"

# S3 configuration:
S3_BUCKET="uatmms-models"
S3_MODEL_PREFIX="models/"
S3_ENDPOINT_URL=""

# For local development with LocalStack:
# S3_ENDPOINT_URL="http://localhost:4566"

# ============================================================================
# SUMO TRAFFIC SIMULATION
# ============================================================================
# Installation paths:
SUMO_HOME="/opt/sumo"
SUMO_BINARY="/opt/sumo/bin/sumo"

# Network files (relative paths or absolute):
SIMULATION_NETWORK_FILE="data/bangalore_network/bangalore_core.net.xml"
SIMULATION_ROUTE_FILE="data/bangalore_network/bangalore_routes.rou.xml"
SIMULATION_CONFIG_FILE="data/bangalore_network/bangalore.sumocfg"

# Simulation parameters:
SIMULATION_SEED="42"
SIMULATION_START_TIME="0"
SIMULATION_END_TIME="3600"
SIMULATION_STEP_LENGTH="0.1"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment: development, staging, production
APP_ENV="development"

# Debug mode (set to false in production):
DEBUG="true"

# Application title and version:
APP_TITLE="UATMMS"
APP_VERSION="1.0.0"

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Secrets (CHANGE IN PRODUCTION):
SECRET_KEY="your-super-secret-key-change-me-in-production"
JWT_SECRET_KEY="your-jwt-super-secret-key-change-me"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS="24"
JWT_REFRESH_EXPIRATION_DAYS="7"

# Password hashing:
BCRYPT_ROUNDS="12"

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_VERSION="v1"
API_BASE_URL="http://localhost:8000"
API_DOCS_URL="/docs"
API_REDOC_URL="/redoc"

# CORS configuration (comma-separated origins):
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"
CORS_ALLOW_CREDENTIALS="true"
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,OPTIONS,PATCH"
CORS_ALLOW_HEADERS="*"

# Allowed hosts (comma-separated):
ALLOWED_HOSTS="localhost,127.0.0.1,yourdomain.com"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
WORKERS="4"
RELOAD="true"

# ============================================================================
# MACHINE LEARNING / REINFORCEMENT LEARNING
# ============================================================================
# PyTorch configuration:
PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:512"
TORCH_HOME="/tmp/torch_cache"

# RL Training parameters:
RL_ALGORITHM="ppo"
RL_TOTAL_TIMESTEPS="1000000"
RL_EVAL_EPISODES="100"
RL_SAVE_FREQUENCY="10000"

# Model checkpoint and logging:
MODEL_CHECKPOINT_DIR="backend/data/models/checkpoints/"
MODEL_LOG_DIR="backend/data/logs/"

# ============================================================================
# SECURITY & SSL/TLS
# ============================================================================
# HTTPS/SSL (for production):
USE_HTTPS="false"
SSL_CERT_PATH="/path/to/cert.pem"
SSL_KEY_PATH="/path/to/key.pem"

# Rate limiting:
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW_SECONDS="60"

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Sentry error tracking (optional):
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Logging configuration:
LOG_FILE="backend/logs/uatmms.log"
LOG_MAX_BYTES="10485760"
LOG_BACKUP_COUNT="5"
ENABLE_METRICS="true"

# ============================================================================
# DATABASE MIGRATIONS
# ============================================================================
# Alembic configuration:
SQLALCHEMY_ECHO="false"
ALEMBIC_SCRIPT_LOCATION="backend/alembic"

# ============================================================================
# EMAIL CONFIGURATION (Optional, for notifications)
# ============================================================================
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM_EMAIL="noreply@uatmms.com"
EMAIL_ENABLED="false"

# ============================================================================
# TRAFFIC PREDICTION (Phase 6)
# ============================================================================
# Prediction model settings:
PREDICTION_MODEL_TYPE="xgboost"
PREDICTION_LOOKBACK_HOURS="24"
PREDICTION_FORECAST_HOURS="1"

# ============================================================================
# INCIDENT DETECTION (Phase 4)
# ============================================================================
# Incident detection parameters:
INCIDENT_DETECTION_THRESHOLD="0.8"
INCIDENT_VERIFICATION_REQUIRED="true"

# ============================================================================
# EMERGENCY CORRIDORS (Phase 5)
# ============================================================================
# Emergency response settings:
EMERGENCY_CORRIDOR_MAX_DEVICES="10"
EMERGENCY_CORRIDOR_TIME_LIMIT_SECONDS="600"
EMERGENCY_PRIORITY_LEVELS="ambulance=100,fire=90,police=80"

# ============================================================================
# DASHBOARD & WEBSOCKET (Phase 9)
# ============================================================================
# WebSocket configuration:
WEBSOCKET_ENABLED="true"
WEBSOCKET_URL="ws://localhost:8000/ws"
WEBSOCKET_HEARTBEAT_INTERVAL="30"

# Dashboard update frequency (seconds):
DASHBOARD_UPDATE_FREQUENCY="5"

# ============================================================================
# 3D DIGITAL TWIN (Phase 10)
# ============================================================================
# 3D Twin configuration:
TWIN_ENABLED="false"
TWIN_UPDATE_FREQUENCY="10"
TWIN_LOD_LEVELS="4"

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features by phase:
ENABLE_PHASE_1="true"      # Network Topology
ENABLE_PHASE_2="true"      # Traffic Generation
ENABLE_PHASE_3="true"      # Safety & Corridors
ENABLE_PHASE_4="true"      # Incident Detection
ENABLE_PHASE_5="true"      # Emergency Corridors
ENABLE_PHASE_6="true"      # Traffic Prediction
ENABLE_PHASE_7="true"      # Reinforcement Learning
ENABLE_PHASE_8="true"      # Database & Auth
ENABLE_PHASE_9="true"      # Command Centre Dashboard
ENABLE_PHASE_10="false"    # 3D Digital Twin

# ============================================================================
# DEVELOPMENT UTILITIES
# ============================================================================
# Seed initial data:
SEED_INITIAL_DATA="false"

# Generate test data:
GENERATE_TEST_DATA="false"

# ============================================================================
# NOTES:
# ============================================================================
# 1. NEVER commit .env file to version control
# 2. Add .env to .gitignore
# 3. For production, use AWS Secrets Manager or similar
# 4. Rotate credentials regularly
# 5. Use different values for dev/staging/production
# 6. Keep sensitive data out of logs
# 7. Update this file when adding new configuration options
#
# Last Updated: October 2026
# ============================================================================
