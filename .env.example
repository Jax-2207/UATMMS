# UATMMS Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.

# General / Server
UATMMS_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True
SECRET_KEY=uatmms-super-secret-dev-key-change-in-production

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
# For production/full testing use PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uatmms_db
# For lightweight local setup without running PostgreSQL:
USE_SQLITE_DEV_FALLBACK=True
SQLITE_DB_PATH=backend/uatmms_dev.db

# Authentication / Firebase
MOCK_AUTH_FOR_DEV=True
FIREBASE_PROJECT_ID=uatmms-traffic-control
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Traffic Simulation (SUMO)
# Set SUMO_HOME to your local SUMO installation directory
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
SUMO_BINARY=sumo
SUMO_GUI_BINARY=sumo-gui
DEFAULT_STEP_LENGTH=1.0
DEFAULT_PORT=8813

# Logging & Monitoring
LOG_LEVEL=INFO
METRICS_SAMPLE_INTERVAL_SECONDS=5

# Frontend Environment Variables (apps/web/.env)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws/simulation
VITE_ENABLE_MOCK_DATA=true
