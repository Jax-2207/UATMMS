<?xml version="1.0" encoding="UTF-8"?>
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
    <!-- North incoming -->
    <connection from="E_N_in" to="E_W_out" fromLane="0" toLane="0"/>
    <connection from="E_N_in" to="E_S_out" fromLane="0" toLane="0"/>
    <connection from="E_N_in" to="E_S_out" fromLane="1" toLane="1"/>
    <connection from="E_N_in" to="E_E_out" fromLane="1" toLane="1"/>

    <!-- South incoming -->
    <connection from="E_S_in" to="E_E_out" fromLane="0" toLane="0"/>
    <connection from="E_S_in" to="E_N_out" fromLane="0" toLane="0"/>
    <connection from="E_S_in" to="E_N_out" fromLane="1" toLane="1"/>
    <connection from="E_S_in" to="E_W_out" fromLane="1" toLane="1"/>

    <!-- East incoming -->
    <connection from="E_E_in" to="E_N_out" fromLane="0" toLane="0"/>
    <connection from="E_E_in" to="E_W_out" fromLane="0" toLane="0"/>
    <connection from="E_E_in" to="E_W_out" fromLane="1" toLane="1"/>
    <connection from="E_E_in" to="E_S_out" fromLane="1" toLane="1"/>

    <!-- West incoming -->
    <connection from="E_W_in" to="E_S_out" fromLane="0" toLane="0"/>
    <connection from="E_W_in" to="E_E_out" fromLane="0" toLane="0"/>
    <connection from="E_W_in" to="E_E_out" fromLane="1" toLane="1"/>
    <connection from="E_W_in" to="E_N_out" fromLane="1" toLane="1"/>
</connections>
