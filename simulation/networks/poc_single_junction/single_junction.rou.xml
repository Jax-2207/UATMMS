<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle Types -->
    <vType id="passenger_car" length="4.50" maxSpeed="13.89" accel="2.6" decel="4.5" color="0,242,254" minGap="1.5"/>
    <vType id="two_wheeler" length="1.80" maxSpeed="13.89" accel="3.0" decel="5.0" color="16,185,129" minGap="0.8"/>
    <vType id="auto_rickshaw" length="2.80" maxSpeed="11.11" accel="2.0" decel="4.0" color="245,158,11" minGap="1.0"/>
    <vType id="emergency_ambulance" length="6.00" maxSpeed="20.00" accel="3.5" decel="6.0" color="239,68,68" vClass="emergency"/>

    <!-- Routes -->
    <route id="r_N_to_S" edges="E_N_in E_S_out"/>
    <route id="r_S_to_N" edges="E_S_in E_N_out"/>
    <route id="r_E_to_W" edges="E_E_in E_W_out"/>
    <route id="r_W_to_E" edges="E_W_in E_E_out"/>

    <!-- Synthetic Vehicle Flows -->
    <flow id="flow_NS" type="passenger_car" route="r_N_to_S" begin="0" end="1000" probability="0.3"/>
    <flow id="flow_SN" type="two_wheeler" route="r_S_to_N" begin="0" end="1000" probability="0.3"/>
    <flow id="flow_EW" type="auto_rickshaw" route="r_E_to_W" begin="0" end="1000" probability="0.2"/>
    <flow id="flow_WE" type="passenger_car" route="r_W_to_E" begin="0" end="1000" probability="0.2"/>

    <!-- Representative Emergency Vehicle -->
    <vehicle id="EMG_AMB_01" type="emergency_ambulance" route="r_N_to_S" depart="45"/>
</routes>
