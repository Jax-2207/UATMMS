<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="passenger_car" length="4.50" maxSpeed="16.67" accel="2.6" decel="4.5" minGap="1.50" tau="0.9" color="0,242,254"/>
    <vType id="two_wheeler" length="1.80" maxSpeed="14.00" accel="3.2" decel="5.0" minGap="0.60" tau="0.6" color="16,185,129"/>
    <vType id="auto_rickshaw" length="2.80" maxSpeed="11.11" accel="2.0" decel="4.0" minGap="1.00" tau="0.8" color="245,158,11"/>
    <vType id="city_bus" length="11.50" maxSpeed="11.11" accel="1.4" decel="3.5" minGap="2.50" tau="1.2" color="59,130,246"/>
    <vType id="emergency_ambulance" length="6.00" maxSpeed="22.22" accel="3.5" decel="6.0" minGap="1.20" tau="0.7" color="239,68,68" vClass="emergency"/>

    <route id="r_MG_corridor_EW" edges="E_W1_in E_MG_J1_J2 E_MG_J2_J3 E_E3_out"/>
    <route id="r_MG_corridor_WE" edges="E_E3_in E_MG_J3_J2 E_MG_J2_J1 E_W1_out"/>
    <route id="r_Brigade_NS" edges="E_N2_in E_BRIGADE_J2_J5 E_CO_J5_J6"/>
    <route id="r_Church_to_Commercial" edges="E_N1_in E_VERT_J1_J4 E_CH_J4_J5 E_CO_J5_J6"/>

    <!-- Peak Rush Hour Flows (~3,000 veh/hr) with High Bottleneck Queueing -->
    <flow id="f_peak_mg_car" type="passenger_car" route="r_MG_corridor_EW" begin="0" end="3600" probability="0.25"/>
    <flow id="f_peak_mg_bike" type="two_wheeler" route="r_MG_corridor_EW" begin="0" end="3600" probability="0.30"/>
    <flow id="f_peak_mg_auto" type="auto_rickshaw" route="r_MG_corridor_WE" begin="0" end="3600" probability="0.20"/>
    <flow id="f_peak_brigade_bus" type="city_bus" route="r_Brigade_NS" begin="0" end="3600" probability="0.08"/>
    <flow id="f_peak_brigade_car" type="passenger_car" route="r_Brigade_NS" begin="0" end="3600" probability="0.18"/>
    <flow id="f_peak_church_bike" type="two_wheeler" route="r_Church_to_Commercial" begin="0" end="3600" probability="0.15"/>

    <!-- Peak Hour Critical Emergency Dispatches -->
    <vehicle id="AMB_RUSH_CARDIAC" type="emergency_ambulance" route="r_MG_corridor_EW" depart="90"/>
    <vehicle id="AMB_RUSH_TRAUMA" type="emergency_ambulance" route="r_Brigade_NS" depart="180"/>
</routes>
